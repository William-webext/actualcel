# URL del tuo server Actual raggiungibile dal container (rete Docker interna
# se sta nello stesso stack/rete di actual-server, altrimenti IP LAN del NAS)
ACTUAL_SERVER_URL=http://actual_server:5006

# Password del server Actual (quella che usi per fare login sulla web app)
ACTUAL_PASSWORD=

# Settings -> Show advanced settings -> Sync ID, del budget che vuoi usare
ACTUAL_SYNC_ID=

# Solo se hai attivato la crittografia end-to-end sul budget, altrimenti lascia vuoto
ACTUAL_ENCRYPTION_PASSWORD=

# PIN che protegge l'accesso a questa mini-app da mobile (numerico o alfanumerico, a piacere)
APP_PIN=

# Stringa casuale lunga, usata per firmare i cookie di sessione — generane una con:
# openssl rand -hex 32
SESSION_SECRET=

# Porta interna del servizio (di solito non serve cambiarla)
PORT=8730

# Ogni quanti minuti risincronizzare in background con il server Actual
SYNC_INTERVAL_MINUTES=10
